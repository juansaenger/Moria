# ============================================================================
#  Home bot settings. Fill in everything marked REQUIRED, save the file as
#  homebot.env, and upload it to your server (see README).
#
#  Format: NAME=value on one line. No quotes, no spaces around the = sign.
#  Keep this file private: it holds passwords to your house and accounts.
# ============================================================================

# --- Claude (REQUIRED) -------------------------------------------------------
# console.anthropic.com -> API Keys -> Create Key. Starts with sk-ant-
ANTHROPIC_API_KEY=

# --- Discord (REQUIRED) ------------------------------------------------------
# discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Turn on Discord Developer Mode (User Settings -> Advanced), then
# right-click #homeassistant -> Copy Channel ID
DISCORD_CHANNEL_ID=
# Right-click your own name -> Copy User ID. Add your wife's after a comma:
# 111111111111111111,222222222222222222
DISCORD_ALLOWED_USER_IDS=

# --- Home Assistant (REQUIRED) -----------------------------------------------
# The address you open Home Assistant at on your home network.
# Use the IP address, not "localhost" or "homeassistant.local".
HOMEASSISTANT_URL=http://192.168.1.10:8123
# Home Assistant -> click your name (bottom left) -> Security tab ->
# Long-lived access tokens -> Create token
HOMEASSISTANT_TOKEN=

# --- Time zone (REQUIRED) ----------------------------------------------------
# e.g. America/New_York, America/Chicago, America/Denver, America/Los_Angeles
TZ=America/New_York

# --- Optional: Plex / downloads (Seerr, Sonarr, Radarr, qBittorrent) --------
# Fill these in and the bot can answer "where is my show", find stuck downloads,
# search for missing episodes and grab releases. Leave blank to turn a service off.
# Each *arr app shows its key under Settings -> General -> API Key.
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=
# Seerr / Overseerr / Jellyseerr: Settings -> General -> API Key
SEERR_URL=http://192.168.1.10:5055
SEERR_API_KEY=
# qBittorrent Web UI login (Tools -> Options -> Web UI). Blank username = off.
# If the Web UI has "Bypass authentication for whitelisted IPs" covering the
# server, put QBIT_USERNAME=bypass and leave the password blank.
QBIT_URL=http://192.168.1.10:8080
QBIT_USERNAME=
QBIT_PASSWORD=

# --- Optional: you can leave everything below as is --------------------------
# claude-opus-5-5 (smartest), claude-sonnet-5-5 (cheaper), claude-haiku-4-5 (cheapest)
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high. Low is plenty for home control. Ignored for Haiku.
CLAUDE_EFFORT=low
# 24-hour time, or off
# Nightly look round the house (lights, doors, locks). Silent when all is well.
NIGHTLY_CHECK_TIME=22:30
# Morning look at downloads (stalled requests, stuck torrents). Silent when healthy.
DOWNLOAD_CHECK_TIME=09:00
MORNING_SUMMARY_TIME=off
# Every action in these domains needs you to tap Approve
SENSITIVE_DOMAINS=lock,alarm_control_panel
# Actions on devices whose name contains any of these words need approval too
SENSITIVE_KEYWORDS=lock,garage,alarm,oven,stove,door,gate,security

# --- Optional: server health check ------------------------------------------
# Leave any of these blank to skip that part of the check.
# Scrutiny (drive SMART data). The address you open Scrutiny at.
SCRUTINY_URL=
# The machine running the UPS daemon (usually the server itself).
NUT_HOST=
NUT_PORT=3493
# Uptime Kuma needs an API key: Settings -> API Keys -> Add API Key.
UPTIMEKUMA_URL=
UPTIMEKUMA_API_KEY=
# Warn when a filesystem drops below this much free space, as a percentage.
DISK_MIN_FREE_PCT=10
# Time of the daily server health check, or off.
SERVER_CHECK_TIME=08:45

# How long Claude keeps your tools and instructions cached: 1h, 5m or off.
# 1h is much cheaper for a bot that gets messages hours apart.
CACHE_TTL=1h

# Lets the cleanup check tell a hardlinked file from one really using space.
# Left of the = is the path your download client reports, right of it is where
# this container can see it (see the volumes in docker-compose.yml).
PATH_MAP=/downloads=/host/media/torrents,/media/sda2=/host/media
# Set to true when the deploy watcher is installed on the server, so the bot
# tells you a merged pull request ships by itself instead of sending you to
# redeploy by hand.
DEPLOY_ON_MERGE=true
