# --- Claude (https://console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default), claude-sonnet-5-5 (cheaper), or claude-haiku-4-5 (cheapest)
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high. Low is plenty for home control. Ignored for Haiku.
CLAUDE_EFFORT=low

# --- Discord (see README) ---
DISCORD_BOT_TOKEN=
# Right-click the #home channel -> Copy Channel ID (needs Developer Mode on)
DISCORD_CHANNEL_ID=
# Comma-separated user IDs allowed to talk to the bot and press Approve
DISCORD_ALLOWED_USER_IDS=

# --- Home Assistant ---
# Use the LAN address; "localhost" won't work from inside the container.
HOMEASSISTANT_URL=http://192.168.1.10:8123
# Profile -> Security -> Long-lived access tokens
HOMEASSISTANT_TOKEN=

# --- Behaviour ---
TZ=America/New_York
# HH:MM or off
NIGHTLY_CHECK_TIME=22:30
MORNING_SUMMARY_TIME=off
# Calls on these domains always need approval
SENSITIVE_DOMAINS=lock,alarm_control_panel
# Calls on entities whose id or name contains any of these words need approval
SENSITIVE_KEYWORDS=lock,garage,alarm,oven,stove,door,gate,security
